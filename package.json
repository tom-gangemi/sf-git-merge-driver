{
  "name": "sf-git-merge-driver",
  "description": "Git merge driver for Salesforce metadata XML files - automatically resolves merge conflicts in profiles, permission sets, and 50+ metadata types",
  "version": "2.0.2",
  "exports": "./lib/driver/MergeDriver.js",
  "type": "module",
  "bin": {
    "sf-git-merge-driver": "./bin/merge-driver.cjs"
  },
  "author": "Sébastien Colladon (colladonsebastien@gmail.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scolladon/sf-git-merge-driver.git"
  },
  "dependencies": {
    "@oclif/core": "5.1.0",
    "@salesforce/core": "9.2.0",
    "@salesforce/sf-plugins-core": "13.0.4",
    "@scolladon/tsgit": "4.0.0"
  },
  "engines": {
    "node": ">=22.22.1",
    "npm": ">=12"
  },
  "files": [
    "/lib",
    "/messages",
    "/oclif.manifest.json",
    "/oclif.lock",
    "/bin"
  ],
  "keywords": [
    "sf",
    "sf-plugin",
    "source",
    "git",
    "merge",
    "driver"
  ],
  "license": "MIT",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "sf",
    "topicSeparator": " ",
    "flexibleTaxonomy": true,
    "devPlugins": [
      "@oclif/plugin-help"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
